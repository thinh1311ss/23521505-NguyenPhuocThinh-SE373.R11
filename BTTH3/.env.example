# Cấu hình biến môi trường cho Agent Đặt Vé Máy Bay
# Đổi tên file này thành .env và điền thông tin nếu muốn chạy với model thật (--that)

# Nhà cung cấp OpenAI hoặc OpenAI-compatible API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Tùy chọn giả lập lỗi môi trường hệ thống để kiểm thử điều kiện dừng:
# SE373_FLIGHT_ERROR=1
